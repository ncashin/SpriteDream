{
  "name": "gameide",
  "version": "0.1.0",
  "description": "GameIDE editor library and CLI",
  "repository": {
    "type": "git",
    "url": "https://github.com/ncashin/gameide.git"
  },
  "type": "module",
  "bin": {
    "gameide": "./dist/cli.js"
  },
  "main": "./dist/gameide.umd.js",
  "module": "./dist/gameide.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./styles.css": "./styles.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gameide.es.js",
      "require": "./dist/gameide.umd.js",
      "default": "./dist/gameide.es.js"
    },
    "./vite": {
      "types": "./dist/gameidePluginVite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./vite/client": {
      "types": "./dist/viteClient.d.ts"
    }
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "npm run build -w gameide-cli && vite build && vite build --config vite.plugin.config.ts && cp src/vitePlugin/client.d.ts dist/viteClient.d.ts && cp ../cli/dist/cli.js ../cli/dist/index.js dist/",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.12.1",
    "@blueprintjs/icons": "^6.9.1",
    "@dnd-kit/core": "^6.3.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "tiny-invariant": "^1.3.3",
    "ws": "^8.20.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  }
}
