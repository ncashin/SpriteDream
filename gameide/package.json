{
  "name": "gameide",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/gameide.umd.js",
  "module": "./dist/gameide.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./styles.css": "./styles.css",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gameide.es.js",
      "require": "./dist/gameide.umd.js",
      "default": "./dist/gameide.es.js"
    },
    "./vite": {
      "types": "./dist/gameidePluginVite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.plugin.config.ts",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.12.1",
    "@blueprintjs/icons": "^6.9.1",
    "@dnd-kit/core": "^6.3.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0",
    "tiny-invariant": "^1.3.3",
    "ws": "^8.20.0",
    "zod": "^3.25.76"
  }
}
