{
  "name": "natstack",
  "displayName": "NatStack",
  "description": "A VS Code extension for NatStack",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:scene",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "scene",
        "aliases": ["Scene", "scene"],
        "extensions": [".scene"],
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "natstack.sceneEditor",
        "displayName": "Scene Editor",
        "selector": [
          {
            "filenamePattern": "*.scene"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "natstack.exportToTauri",
        "title": "Export to Tauri Runtime"
      },
      {
        "command": "natstack.uploadGame",
        "title": "Upload Game to Website"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@types/archiver": "^6.0.2",
    "@types/form-data": "^2.5.0",
    "typescript": "^4.9.4"
  }
}