{
  "type": "module",
  "name": "gameide-extension",
  "publisher": "gameide",
  "displayName": "GameIDE",
  "description": "Open .scene files in a custom editor",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ncashin/gameide.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:gameide.createProject",
    "onCommand:gameide.uploadGame",
    "workspaceContains:**/*.scene"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gameide.createProject",
        "title": "Create Project",
        "category": "GameIDE"
      },
      {
        "command": "gameide.uploadGame",
        "title": "Upload Game",
        "category": "GameIDE"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "gameide.uploadGame",
          "group": "navigation@50",
          "when": "explorerResourceIsFolder || explorerResourceIsFile"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "gameide.sceneEditor",
        "displayName": "Scene Editor",
        "selector": [
          {
            "filenamePattern": "*.scene"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".scene"
        ],
        "aliases": [
          "Scene (JSON)"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run build -w gameide-cli && vite build",
    "watch": "vite build --watch",
    "package": "npm run compile && npx vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "~5.6.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "gameide": "*",
    "gameide-cli": "*"
  }
}
