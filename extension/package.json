{
  "type": "module",
  "name": "gameide-extension",
  "publisher": "gameide",
  "displayName": "GameIDE",
  "description": "Open .scene files in a custom editor",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ncashin/gameide.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.scene"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gameide",
          "title": "GameIDE",
          "icon": "$(file-code)"
        }
      ]
    },
    "views": {
      "gameide": [
        {
          "type": "webview",
          "id": "gameide.sceneViewSidebar",
          "name": "Scene View Sidebar"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "gameide.sceneEditor",
        "displayName": "Scene Editor",
        "selector": [
          {
            "filenamePattern": "*.scene"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".scene"
        ],
        "aliases": [
          "Scene (JSON)"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "vite build",
    "watch": "vite build --watch",
    "package": "npm run compile && npx vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "gameide": "*",
    "lucide": "^0.577.0"
  }
}
