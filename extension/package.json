{
  "name": "natstack",
  "displayName": "NatStack",
  "description": "A VS Code extension for NatStack",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:natstack.helloWorld",
    "onCommand:natstack.showWebView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "natstack.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "natstack.showWebView",
        "title": "Show WebView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  }
}