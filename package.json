{
  "name": "gameide-monorepo",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=18",
    "vscode": "^1.85.0"
  },
  "workspaces": [
    "gameide-cli",
    "gameide",
    "runtime",
    "extension"
  ],
  "scripts": {
    "dev": "sh -c 'npm run build -w gameide && npm run dev --prefix webapp & npm run dev -w runtime'",
    "watch": "npm run watch -w extension"
  }
}
